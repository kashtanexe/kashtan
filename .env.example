# ---------------------------------------------------------------------------
# FILTR environment variables
# Every variable is OPTIONAL. With none set, the app runs in DEMO MODE:
# seeded in-memory store, emails captured in the Outbox, simulated payments,
# deterministic heuristic scorer. Add keys one service at a time.
# ---------------------------------------------------------------------------

# Public URL of the app (used in email links). On Vercel, VERCEL_URL is used if unset.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Force demo mode even if keys are present ("true" / "1"). Leave empty normally.
DEMO_MODE=

# Signs pitch links and 1-click email actions. REQUIRED outside demo mode.
# Generate: openssl rand -base64 32
TOKEN_SECRET=

# --- Supabase (database + magic-link auth) -----------------------------------
# All three are needed to leave demo mode.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Postmark (inbound + outbound email) -------------------------------------
POSTMARK_SERVER_TOKEN=
# Basic-auth credentials you embed in the inbound webhook URL:
#   https://USER:PASSWORD@your-app.vercel.app/api/webhooks/inbound-email
POSTMARK_INBOUND_USER=
POSTMARK_INBOUND_PASSWORD=
# Separate message streams keep challenge mail and digests apart (default: "outbound")
POSTMARK_CHALLENGE_STREAM=challenges
POSTMARK_DIGEST_STREAM=digests
# Your authenticated sending subdomain (SPF + DKIM + DMARC) and inbound domain (MX → Postmark)
MAIL_FROM_DOMAIN=mail.yourdomain.com
INBOUND_DOMAIN=in.yourdomain.com

# --- Stripe (Fast-Track payments + refunds) ----------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Anthropic (scoring + triage) --------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_TRIAGE_MODEL=claude-haiku-5-5

# --- Cron ---------------------------------------------------------------------
# Vercel sends "Authorization: Bearer $CRON_SECRET" to cron routes when this is set.
CRON_SECRET=
